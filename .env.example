# LLM API configuration (OpenAI-compatible)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o

# Android device connection
DEVICE_HOST=192.168.1.100
DEVICE_PORT=8765

# Whisper configuration
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Interaction mode: single_command or continuous
INTERACTION_MODE=single_command

# Safety: none, sensitive, all
CONFIRMATION_LEVEL=sensitive

# TTS (optional)
ENABLE_TTS=false

# Logging
LOG_LEVEL=INFO
